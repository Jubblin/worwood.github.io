---
// Port of themes/online-resume/layouts/partials/{common,head,close}.html.
// Site params from hugo.yaml are inlined as constants.
import "../../styles/main.scss";
import Basic from "./Basic.astro";
import Profile from "./Profile.astro";
import Experience from "./Experience.astro";
import Skill from "./Skill.astro";
import Organization from "./Organization.astro";
import Reference from "./Reference.astro";
import { md } from "../../lib/markdown";

const SITE = {
  baseURL: "https://worwood.com",
  title: "Richard Worwood",
  description: "",
  open: true,
  ogImage: "/images/profile.png",
  googleAnalytics: "G-4P41QTWLR4",
  close: "<strong>Sorry, my resume has been hidden.</strong>",
};

interface Props {
  data: {
    meta?: { language?: string; direction?: string };
    basic?: any; contact?: any; profile?: any; experience?: any; skill?: any; organization?: any; reference?: any;
  };
  open?: boolean;
}
const { data, open = SITE.open } = Astro.props;
const description = open ? SITE.description || SITE.title : "Online Resume";
---
<!DOCTYPE html>
<html lang={data.meta?.language || "en"} dir={data.meta?.direction || "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {open && (
      <Fragment>
        <meta property="og:title" content={SITE.title} />
        <meta property="og:type" content="profile" />
        <meta property="og:image" content={new URL(SITE.ogImage, SITE.baseURL).href} />
        <meta property="og:url" content={`${SITE.baseURL}/`} />
        {SITE.description && <meta property="og:description" content={SITE.description} />}
      </Fragment>
    )}
    <title>{open ? SITE.title : "Online Resume"}</title>
    <link rel="stylesheet" href="/assets/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/assets/fontawesome/css/brands.min.css" />
    <link rel="stylesheet" href="/assets/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="/assets/icons/css/all.css" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalytics}`}></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-4P41QTWLR4");
    </script>
  </head>
  <body>
    {open ? (
      <div class="wrapper">
        <Basic basic={data.basic} contact={data.contact} />
        <Profile profile={data.profile} />
        <Experience experience={data.experience} />
        <Skill skill={data.skill} />
        <Organization organization={data.organization} />
        <Reference reference={data.reference} />
      </div>
    ) : (
      <div class="close"><div class="description" set:html={md(SITE.close)} /></div>
    )}
  </body>
</html>
